{
  "name": "photocloud-mobile",
  "private": true,
  "version": "1.5.5",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "start:rust": "node -e \"import('node:child_process').then(({spawnSync})=>{const bin=process.platform==='win32'?'rust/app/target/release/server.exe':'rust/app/target/release/server';const r=spawnSync(bin,{stdio:'inherit'});process.exit(r.status??1);})\"",
    "build:rust": "cargo build --release --manifest-path rust/app/Cargo.toml",
    "test:rust": "python3 tests/test_rust_server_e2e.py",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "release:check": "tsx scripts/check-release-gate.ts",
    "release:apk": "npm run release:check && tsx scripts/publish-github-release.ts",
    "android:signing:setup": "tsx scripts/setup-persistent-signing.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "hash-wasm": "4.12.0",
    "jimp": "1.6.1",
    "jszip": "3.10.2",
    "multer": "2.5.0",
    "tsx": "4.23.15",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0"
  }
}
