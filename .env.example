PORT=3000
TRUST_PROXY=false

# GitHub Personal Access Token (repo scope) to publish the compiled APK to ValerioMassimoDeCecco/PhotoCloud Releases
GITHUB_TOKEN=

# Optional custom path to protected signing properties file (defaults automatically to ~/.photocloud/signing.properties)
PHOTOCLOUD_SIGNING_PROPERTIES=

# Android Release Signing Credentials
# Optional locally: auto-loaded from ~/.photocloud/signing.properties (mode 0600) and saved automatically on first release build.
# If supplied manually via env vars in a local build, they are persisted to ~/.photocloud/signing.properties for future builds.
PHOTOCLOUD_KEYSTORE_PATH=
PHOTOCLOUD_KEYSTORE_PASSWORD=
PHOTOCLOUD_KEY_ALIAS=
PHOTOCLOUD_KEY_PASSWORD=
PHOTOCLOUD_KEYSTORE_TYPE=
