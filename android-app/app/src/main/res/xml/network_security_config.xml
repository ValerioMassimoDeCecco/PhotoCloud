<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Release policy: cleartext HTTP strictly forbidden for ALL hosts (including loopback). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
